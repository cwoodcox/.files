{{- /* Absolute path to gh, resolved per machine: Homebrew lives at
       /opt/homebrew on Apple Silicon and /usr/local on Intel, and this file
       previously hardcoded both, so one machine's credential helper was always
       broken. Credential helpers need the absolute path because git invoked
       from a GUI app doesn't necessarily have Homebrew on PATH. Falls back to
       the Apple Silicon location for a fresh machine where brew hasn't run
       yet -- which is where brew will put it. */ -}}
{{- $gh := or (lookPath "gh") "/opt/homebrew/bin/gh" -}}
[user]
	name = Corey Woodcox
	email = {{ .email }}
  {{ if eq .machine "personal" }}
  signingkey = {{ onepasswordRead "op://Private/v4q6vrsmte6hvku72nnirscrwm/public key" }}
  {{ else }}
	signingkey = {{ onepasswordRead "op://McKesson/SSH Key/public key" }}
  {{ end }}

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
  gpgsign = true
[core]
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
[color]
	diff = auto
	status = auto
	branch = auto
[rebase]
	autosquash = true
	autostash = true
[push]
	default = current

[hub]
protocol = https
	host = git.innova-partners.com

[alias]
  whereami = --no-pager show --oneline --no-patch
  history = log --pretty='format:%C(yellow)%h %Creset- %C(white)%s %C(bold blue)[%an]%Creset %Cgreen%cr' --graph
  recommit = commit --amend --no-edit
	yolo = push -f
	sstatus = status --short
	icommit = commit -pv
  resign-commits = rebase --exec 'git commit --amend --no-edit -S'
  wtpath = "!f() { git worktree list --porcelain | awk -v n=\"$1\" '/^worktree/ && $2 ~ n {print $2; exit}'; }; f"
[merge]
	defaultToUpstream = true
	tool = vimdiff
[credential]
	helper = osxkeychain
[github]
	user = cwoodcox
[diff]
	tool = vimdiff
[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[credential "https://git.innova-partners.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
