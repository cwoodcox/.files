#!/usr/bin/env bash
# Keep the chezmoi SOURCE repo in sync (fetch + fast-forward only) and notify
# when the remote has moved. This NEVER runs `chezmoi apply` and NEVER does a
# non-fast-forward merge -- writing to the live machine stays a deliberate
# manual step, so nothing here can silently clobber local state.
#
# This runs unattended from a LaunchAgent, so it must not trigger interactive
# prompts:
#   - it fetches over HTTPS, where git's `gh` credential helper supplies the
#     token silently, instead of the SSH remote (which needs a 1Password
#     approval on every run via the op-ssh agent); and
#   - it shells out ONLY to `git`, never to the `chezmoi` binary, which would
#     trip a macOS "chezmoi would like to access files" TCC prompt.
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"
src="$HOME/.local/share/chezmoi"
[ -d "$src/.git" ] || exit 0
command -v git >/dev/null || exit 0

# Fetch from the dedicated HTTPS remote (created by the sync installer) so git's
# `gh` credential helper can auth unattended; the SSH `origin` would need a
# 1Password approval on every run. Nothing to do if it isn't configured.
git -C "$src" remote get-url origin-https >/dev/null 2>&1 || exit 0

# Bound the fetch: a network stall would otherwise block the next scheduled run
# (launchd won't start another until this one exits, and `|| true` can't catch
# a hang, only a non-zero exit). Hard-cap it, killing git and any child via the
# process group.
export GIT_TERMINAL_PROMPT=0
( set -m
  git -C "$src" fetch -q origin-https '+refs/heads/*:refs/remotes/origin/*' 2>/dev/null &
  fpid=$!
  { sleep 20; kill -TERM -"$fpid" 2>/dev/null; sleep 3; kill -KILL -"$fpid" 2>/dev/null; } &
  wpid=$!
  wait "$fpid" 2>/dev/null
  kill "$wpid" 2>/dev/null
) 2>/dev/null || true

counts="$(git -C "$src" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null || echo '0	0')"
behind="${counts%%	*}"
ahead="${counts##*	}"

# Fast-forward only when it is safe: strictly behind (no local commits to
# diverge) and a clean working tree. Otherwise leave the repo untouched.
pulled=0
if [ "${behind:-0}" -gt 0 ] && [ "${ahead:-0}" -eq 0 ] \
   && [ -z "$(git -C "$src" status --porcelain 2>/dev/null)" ]; then
  if git -C "$src" merge --ff-only -q '@{u}' 2>/dev/null; then
    pulled="$behind"
    behind=0
  fi
fi

msgs=()
[ "$pulled" -gt 0 ] && msgs+=("pulled $pulled commit(s) from remote")
[ "${behind:-0}" -gt 0 ] && msgs+=("$behind behind remote (diverged -- resolve manually)")
[ "${ahead:-0}" -gt 0 ] && msgs+=("$ahead commit(s) unpushed")

if [ ${#msgs[@]} -gt 0 ]; then
  body="$(printf '%s; ' "${msgs[@]}")"; body="${body%; }"
  osascript -e "display notification \"$body\" with title \"chezmoi sync\" subtitle \"run chezmoi diff && chezmoi apply\""
fi
