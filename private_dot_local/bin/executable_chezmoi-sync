#!/usr/bin/env bash
# Keep the chezmoi SOURCE repo in sync (fetch + fast-forward only) and notify
# when the remote has moved. This never applies to the live machine on its own
# and never does a non-fast-forward merge; the strongest thing it offers is an
# "Update" notification button that opens an interactive diff+apply you drive
# yourself (chezmoi-review) -- so nothing here can silently clobber local state.
#
# This runs unattended from a LaunchAgent, so it must not trigger interactive
# prompts:
#   - it fetches over HTTPS, where git's `gh` credential helper supplies the
#     token silently, instead of the SSH remote (which needs a 1Password
#     approval on every run via the op-ssh agent); and
#   - it shells out ONLY to `git`, never to the `chezmoi` binary, which would
#     trip a macOS "chezmoi would like to access files" TCC prompt. (The apply
#     runs later in the Terminal window the Update button opens, not here.)
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"
src="$HOME/.local/share/chezmoi"
pending_file="$HOME/.cache/chezmoi-sync-pending"  # source paths a pull changed, for chezmoi-review
[ -d "$src/.git" ] || exit 0
command -v git >/dev/null || exit 0

# Fetch from the dedicated HTTPS remote (created by the sync installer) so git's
# `gh` credential helper can auth unattended; the SSH `origin` would need a
# 1Password approval on every run. Nothing to do if it isn't configured.
git -C "$src" remote get-url origin-https >/dev/null 2>&1 || exit 0

# Bound the fetch: a network stall would otherwise block the next scheduled run
# (launchd won't start another until this one exits, and `|| true` can't catch
# a hang, only a non-zero exit). Hard-cap it, killing git and any child via the
# process group.
export GIT_TERMINAL_PROMPT=0
( set -m
  git -C "$src" fetch -q origin-https '+refs/heads/*:refs/remotes/origin/*' 2>/dev/null &
  fpid=$!
  { sleep 20; kill -TERM -"$fpid" 2>/dev/null; sleep 3; kill -KILL -"$fpid" 2>/dev/null; } &
  wpid=$!
  wait "$fpid" 2>/dev/null
  kill "$wpid" 2>/dev/null
) 2>/dev/null || true

counts="$(git -C "$src" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null || echo '0	0')"
behind="${counts%%	*}"
ahead="${counts##*	}"

# Fast-forward only when it is safe: strictly behind (no local commits to
# diverge) and a clean working tree. Otherwise leave the repo untouched.
pulled=0
if [ "${behind:-0}" -gt 0 ] && [ "${ahead:-0}" -eq 0 ] \
   && [ -z "$(git -C "$src" status --porcelain 2>/dev/null)" ]; then
  before="$(git -C "$src" rev-parse HEAD 2>/dev/null)"
  if git -C "$src" merge --ff-only -q '@{u}' 2>/dev/null; then
    pulled="$behind"
    behind=0
    # Record which source files the pull changed so chezmoi-review can apply
    # only those (source->target mapping happens there, interactively). Append
    # + dedupe so several pulls before a review accumulate instead of clobber.
    mkdir -p "$(dirname "$pending_file")"
    git -C "$src" diff --name-only "$before" HEAD 2>/dev/null >> "$pending_file"
  fi
fi

msgs=()
[ "$pulled" -gt 0 ] && msgs+=("pulled $pulled commit(s) from remote")
[ "${behind:-0}" -gt 0 ] && msgs+=("$behind behind remote (diverged -- resolve manually)")
[ "${ahead:-0}" -gt 0 ] && msgs+=("$ahead commit(s) unpushed")
[ ${#msgs[@]} -eq 0 ] && exit 0
body="$(printf '%s; ' "${msgs[@]}")"; body="${body%; }"

# Notify via alerter when available (osascript is the fallback). A fast-forward
# gets an interactive "Update" button that opens chezmoi-review in iTerm2;
# everything else (diverged / unpushed) is a plain informational alert. alerter
# blocks until clicked or the timeout lapses, so both use a bounded --timeout to
# avoid ever hanging the launchd run.
if command -v alerter >/dev/null 2>&1; then
  if [ "$pulled" -gt 0 ]; then
    choice="$(alerter --title "chezmoi sync" --subtitle "$body" \
                --message "Review and apply the pulled changes?" \
                --actions Update --timeout 60 --sender com.googlecode.iterm2 2>/dev/null)"
    # Match anything containing "Update" so we don't depend on the exact click
    # token; @TIMEOUT / @CLOSED / @CONTENTCLICKED correctly fall through.
    case "$choice" in
      *Update*)
        # Reuse the running iTerm2: new tab in the current window (new window
        # only if none is open), rather than always spawning a fresh window.
        osascript -e 'tell application "iTerm2"' \
                  -e 'activate' \
                  -e 'if (count of windows) = 0 then' \
                  -e 'create window with default profile' \
                  -e 'else' \
                  -e 'tell current window to create tab with default profile' \
                  -e 'end if' \
                  -e 'tell current session of current window to write text "~/.local/bin/chezmoi-review"' \
                  -e 'end tell' 2>/dev/null || true
        ;;
    esac
  else
    alerter --title "chezmoi sync" --message "$body" --timeout 30 --sender com.googlecode.iterm2 >/dev/null 2>&1 || true
  fi
else
  osascript -e "display notification \"$body\" with title \"chezmoi sync\" subtitle \"run chezmoi diff && chezmoi apply\"" 2>/dev/null || true
fi
