{{- $home := .chezmoi.homeDir -}}
{{- $mps := includeTemplate "claude-marketplaces" . | fromJson -}}
#!/usr/bin/env bash
set -euo pipefail

# chezmoi "modify_" script: receives the current ~/.claude/settings.json on
# stdin and emits the desired contents on stdout. This lets us ENFORCE a small
# set of stable preferences while LEAVING volatile keys (model, effortLevel)
# under Claude Code's control -- so switching models never shows as drift and
# never gets reverted by `chezmoi apply`.

# Marketplaces for this machine = shared + machine-specific, resolved by the
# .chezmoitemplates/claude-marketplaces partial from .chezmoidata/claude.yaml.
mps='{{ $mps | toJson }}'

# Stable keys chezmoi enforces everywhere. `model`/`effortLevel` are deliberately
# absent: Claude Code owns them and the merge below preserves whatever is live.
#
# env/hooks notes:
#   - SSH_AUTH_SOCK points Claude sessions at a dedicated ssh-agent holding only
#     the Claude signing key, so commit signing never waits on a 1Password
#     unlock. Real SSH auth is unaffected: ~/.ssh/config sets IdentityAgent for
#     Host *, which takes precedence over SSH_AUTH_SOCK.
#   - GIT_CONFIG_GLOBAL swaps in claude.gitconfig, which signs with that key
#     instead of 1Password's op-ssh-sign.
#   - SessionStart ensures that agent is up, minting the key on a new machine.
#   - PreToolUse routes every Bash call through rtk (token-saving proxy).
stable='{
  "permissions": { "defaultMode": "auto" },
  "theme": "auto",
  "editorMode": "normal",
  "tui": "fullscreen",
  "verbose": false,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "worktree": { "baseRef": "fresh" },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "SSH_AUTH_SOCK": "{{ $home }}/.ssh/claude-agent.sock",
    "GIT_CONFIG_GLOBAL": "{{ $home }}/.config/git/claude.gitconfig"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "/bin/bash {{ $home }}/.ssh/claude-ssh-agent-start.sh >/dev/null 2>&1 || true" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "rtk hook claude" } ] }
    ]
  }
}'

current="$(cat)"
[ -z "${current//[[:space:]]/}" ] && current='{}'

# Without jq (e.g. a fresh machine before Homebrew has run) pass the file
# through unchanged; the next apply once jq is installed will manage it.
command -v jq >/dev/null 2>&1 || { printf '%s' "$current"; exit 0; }

# GitHub OAuth token from gh CLI, baked in at apply time so all agents and the
# GitHub MCP server get it without a separate PAT. Empty string if gh is absent.
github_token=""
if command -v gh >/dev/null 2>&1; then
  github_token="$(gh auth token 2>/dev/null || true)"
fi

# - `$cur * $stable` deep-merges stable keys over the live file (preserving
#   model/effortLevel and any other unmanaged keys).
# - When this machine has marketplaces, `+ { enabledPlugins, extraKnownMarketplaces }`
#   REPLACES those two keys wholesale from the YAML (so a marketplace whose shape
#   changed, e.g. directory -> github, doesn't leave stale keys behind). Because
#   it is a wholesale replace, the YAML is the ONLY source of truth for those two
#   keys: a plugin toggled by hand in the TUI is reverted on the next apply, so
#   record it in .chezmoidata/claude.yaml to make it stick.
# - When it has none, those keys are left exactly as Claude Code has them.
result=$(jq -n --argjson cur "$current" --argjson stable "$stable" --argjson mps "$mps" '
  ($mps | to_entries) as $e
  | ($cur * $stable) as $base
  | if ($e | length) > 0 then
      $base + {
        enabledPlugins: (
          ( [ $e[] as $m | ($m.value.plugins  // [])[] | { ("\(.)@\($m.key)"): true  } ]
          + [ $e[] as $m | ($m.value.disabled // [])[] | { ("\(.)@\($m.key)"): false } ]
          ) | add // {}
        ),
        extraKnownMarketplaces: (
          $e | map({
            key: .key,
            value: ( { source: .value.source }
                     + (if .value.autoUpdate then { autoUpdate: true } else {} end) )
          }) | from_entries
        )
      }
    else
      $base
    end
')

# Inject the GitHub token into the global env so agents and the plugin's MCP
# server process both have it without a separate PAT.
if [ -n "$github_token" ]; then
  result=$(printf '%s' "$result" | jq --arg tok "$github_token" '
    .env.GITHUB_PERSONAL_ACCESS_TOKEN = $tok
  ')
fi

printf '%s\n' "$result"
