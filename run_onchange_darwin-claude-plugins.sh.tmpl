{{- $mps := includeTemplate "claude-marketplaces" . | fromJson -}}
#!/usr/bin/env bash
set -euo pipefail
# `enabledPlugins` only declares intent; Claude Code does not auto-fetch on a
# fresh machine. This registers the marketplaces and installs the plugins
# declared for this machine in .chezmoidata/claude.yaml. Entries listed under
# `disabled:` are deliberately NOT installed -- settings.json pins them off, so
# the marketplace is registered but the plugin stays absent.
# Re-runs whenever that data changes -- data hash: {{ $mps | toJson | sha256sum }}
command -v claude >/dev/null 2>&1 || exit 0
{{ range $name, $mp := $mps -}}
claude plugin marketplace add {{ $mp.ref | quote }} 2>/dev/null || true
{{ range $plugin := $mp.plugins -}}
claude plugin install {{ printf "%s@%s" $plugin $name | quote }} 2>/dev/null || true
{{ end -}}
{{ end -}}
